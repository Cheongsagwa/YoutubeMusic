<Window x:Class="OneMusicSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Music 설치" Width="520" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- 둥근(28) 카드 창 + 그림자. 위쪽은 YT Music 메인 화면처럼 청록 → 블루 빛이 아래로 녹아든다 -->
    <Border Margin="18" CornerRadius="28" Background="{StaticResource Bg}" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
            <Border CornerRadius="28" Height="300" VerticalAlignment="Top" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A40" Offset="0" />
                        <GradientStop Color="#252F3A" Offset="0.55" />
                        <GradientStop Color="#1C3A50" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>

            <!-- 창 끌기 + 닫기 -->
            <Grid x:Name="DragBar" Height="56" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <Button x:Name="CloseButton" Width="36" Height="36" HorizontalAlignment="Right" Margin="0,0,14,0" Click="OnClose" Cursor="Hand" ToolTip="닫기">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="h" Fill="#00FFFFFF" />
                                <Path Data="M7 7l10 10M17 7 7 17" Stroke="#C8C8CE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="h" Property="Fill" Value="#22FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ───── 0. 이미 깔려 있음: 업데이트 / 제거 ───── -->
            <Grid x:Name="MaintainPage" Margin="32,56,32,28" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Image Source="Assets/app.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="YouTube Music" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource OnSurface}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock x:Name="MaintainVersion" FontSize="15" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Content="업데이트" Style="{StaticResource PrimaryPill}" Click="OnUpdate" />
                    <Button Content="제거" Style="{StaticResource ChipPill}" Foreground="#FF6B70" Height="52" FontSize="16" Margin="0,12,0,0" Click="OnUninstall" />
                </StackPanel>
            </Grid>

            <!-- ───── 1. 설치 옵션 ───── -->
            <Grid x:Name="OptionsPage" Margin="32,56,32,28" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="Assets/app.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="YouTube Music" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource OnSurface}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock x:Name="OptionsVersion" FontSize="15" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- One UI 설정 카드 -->
                <Border Grid.Row="1" CornerRadius="24" Background="{StaticResource Card}" Margin="0,28,0,20" Padding="22,8" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="설치 위치" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OnSurface}" />
                                <TextBlock x:Name="PathText" FontSize="13" Foreground="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="변경" Style="{StaticResource ChipPill}" Click="OnBrowse" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Divider}" />
                        <Grid Margin="0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="시작 메뉴 바로가기" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OnSurface}" VerticalAlignment="Center" />
                            <CheckBox x:Name="StartMenuToggle" Grid.Column="1" Style="{StaticResource OneToggle}" IsChecked="True" VerticalAlignment="Center" />
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Divider}" />
                        <Grid Margin="0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="바탕 화면 바로가기" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OnSurface}" VerticalAlignment="Center" />
                            <CheckBox x:Name="DesktopToggle" Grid.Column="1" Style="{StaticResource OneToggle}" IsChecked="True" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <Button x:Name="InstallButton" Content="설치" Style="{StaticResource PrimaryPill}" Click="OnInstall" />
                    <TextBlock x:Name="ErrorText" FontSize="13" Foreground="#FF6B70" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- ───── 2. 설치 중 ───── -->
            <Grid x:Name="ProgressPage" Margin="40,56,40,40" Visibility="Collapsed" Opacity="0">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="Assets/app.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="ProgressTitle" Text="설치하는 중…" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource OnSurface}" HorizontalAlignment="Center" Margin="0,28,0,32" />
                    <!-- One UI 진행 막대: 칩 색 트랙 위 흰 알약 -->
                    <Grid x:Name="Track" Height="8">
                        <Border CornerRadius="4" Background="{StaticResource Chip}" />
                        <Border x:Name="Fill" CornerRadius="4" Background="White" HorizontalAlignment="Left" Width="0" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ───── 3. 끝 ───── -->
            <Grid x:Name="DonePage" Margin="40,56,40,32" Visibility="Collapsed" Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="88" Height="88">
                        <Ellipse x:Name="DoneCircle" Fill="White" />
                        <Path x:Name="DoneMark" Data="M7 12.5l3.2 3.2L17 9" Stroke="Black" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="24" Height="24" Stretch="None" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2" /></Path.LayoutTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="DoneTitle" Text="설치를 마쳤어요" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource OnSurface}" HorizontalAlignment="Center" Margin="0,26,0,0" />
                    <TextBlock x:Name="DoneText" Visibility="Collapsed" FontSize="15" Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CloseDone" Content="닫기" Style="{StaticResource ChipPill}" Height="52" FontSize="16" Click="OnClose" />
                    <Button x:Name="OpenButton" Grid.Column="2" Content="열기" Style="{StaticResource PrimaryPill}" Click="OnOpen" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
