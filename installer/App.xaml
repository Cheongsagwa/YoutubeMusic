<Application x:Class="OneMusicSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- One UI 다크 색 (OneMusic Theme 과 같은 값) -->
        <SolidColorBrush x:Key="Bg" Color="#17171A" />
        <SolidColorBrush x:Key="Card" Color="#232327" />
        <SolidColorBrush x:Key="Chip" Color="#2E2E33" />
        <SolidColorBrush x:Key="ChipHover" Color="#3A3A40" />
        <SolidColorBrush x:Key="OnSurface" Color="#F4F4F6" />
        <SolidColorBrush x:Key="Secondary" Color="#A3A3AB" />
        <SolidColorBrush x:Key="Divider" Color="#1FFFFFFF" />
        <FontFamily x:Key="Font">Pretendard Variable, Pretendard, Segoe UI Variable Text, Malgun Gothic</FontFamily>

        <!-- 알약 버튼: 흰 바탕 검은 글씨 (주 버튼) -->
        <Style x:Key="PrimaryPill" TargetType="Button">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource Font}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="26" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E6E6E9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <!-- 누르면 0.94 로 줄었다가 스프링으로 (One UI 누름) -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.94" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.94" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="6" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 칩 색 알약 (보조 버튼) -->
        <Style x:Key="ChipPill" TargetType="Button" BasedOn="{StaticResource PrimaryPill}">
            <Setter Property="Foreground" Value="{StaticResource OnSurface}" />
            <Setter Property="Background" Value="{StaticResource Chip}" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="20" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource ChipHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One UI 스위치 (48×28) — 켜지면 흰 트랙 · 검은 손잡이, 손잡이는 스프링으로 미끄러진다 (앱의 OneToggle 과 같음) -->
        <Style x:Key="OneToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="48" Height="28" Background="Transparent">
                            <Border x:Name="track" CornerRadius="14" Background="#38FFFFFF" />
                            <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="move" X="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="White" />
                                <Setter TargetName="knob" Property="Fill" Value="Black" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="move" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.42">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="move" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.42">
                                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font}" />
            <Setter Property="Foreground" Value="{StaticResource OnSurface}" />
        </Style>
    </Application.Resources>
</Application>
